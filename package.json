{
  "name": "@danieljvdm/dev-kit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Declarative project development toolkit with portable agent skills.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/agent-skills.git"
  },
  "license": "MIT",
  "bin": {
    "dev-kit": "./bin/dev-kit.mjs",
    "agent-skills": "./bin/agent-skills.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": "./schema/dev-kit.schema.json",
    "./schema/dev-kit.schema.json": "./schema/dev-kit.schema.json",
    "./schema/agent-skills.schema.json": "./schema/agent-skills.schema.json",
    "./schema/skill-sources.schema.json": "./schema/skill-sources.schema.json"
  },
  "files": [
    "dev-kit.example.jsonc",
    "bin/",
    "schema/",
    "skills/",
    "third-party/",
    "skill-sources.jsonc",
    "skill-sources.lock.json",
    "src/"
  ],
  "scripts": {
    "prepare": "./bin/dev-kit.mjs tsgo patch",
    "check": "tsc --noEmit",
    "sync": "./bin/dev-kit.mjs sync",
    "sync:dry": "./bin/dev-kit.mjs sync --dry-run",
    "plan": "./bin/dev-kit.mjs plan",
    "apply": "./bin/dev-kit.mjs apply",
    "gitignore": "./bin/dev-kit.mjs gitignore",
    "test": "bun run test:node && bun run test:effect",
    "test:node": "node --import tsx --test test/effect-skill.test.ts test/sync.test.ts test/vendor.test.ts",
    "test:effect": "vitest run --config vitest.config.ts",
    "test:effect:watch": "vitest --config vitest.config.ts",
    "tsgo:patch": "./bin/dev-kit.mjs tsgo patch",
    "typecheck": "tsc --noEmit",
    "vendor": "./bin/dev-kit.mjs vendor",
    "vendor:locked": "./bin/dev-kit.mjs vendor --locked"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "jsonc-parser": "3.3.1",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "25.9.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
