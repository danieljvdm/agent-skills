{
  "name": "@danieljvdm/dev-kit",
  "version": "0.9.0",
  "private": false,
  "description": "Declarative project development toolkit with portable agent skills.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieljvdm/dev-kit.git"
  },
  "bin": {
    "dev-kit": "bin/dev-kit.mjs"
  },
  "files": [
    "dev-kit.example.jsonc",
    "bin/",
    "schema/",
    "skills/",
    "skill-sources.jsonc",
    "skill-sources.lock.json",
    "src/",
    "templates/"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": "./schema/dev-kit.schema.json",
    "./schema/dev-kit.schema.json": "./schema/dev-kit.schema.json",
    "./schema/skill-sources.schema.json": "./schema/skill-sources.schema.json",
    "./oxlint": {
      "types": "./src/oxlint.ts",
      "default": "./src/oxlint.js"
    },
    "./oxfmt": {
      "types": "./src/oxfmt.ts",
      "default": "./src/oxfmt.js"
    },
    "./oxlint-plugin-effect": {
      "types": "./src/oxlint-plugin-effect.d.ts",
      "default": "./src/oxlint-plugin-effect.js"
    },
    "./oxlint-plugin-style": {
      "types": "./src/oxlint-plugin-style.d.ts",
      "default": "./src/oxlint-plugin-style.js"
    }
  },
  "scripts": {
    "prepare": "./bin/dev-kit.mjs apply --locked",
    "dev-kit": "./bin/dev-kit.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && ./bin/dev-kit.mjs apply",
    "release": "changeset publish",
    "lint": "vp lint",
    "plan": "./bin/dev-kit.mjs plan",
    "apply": "./bin/dev-kit.mjs apply",
    "gitignore": "./bin/dev-kit.mjs gitignore",
    "effect:sync": "./bin/dev-kit.mjs effect sync",
    "test": "vp test",
    "test:watch": "vitest --config vitest.config.ts",
    "tsgo:patch": "./bin/dev-kit.mjs tsgo patch",
    "catalog:refresh": "./bin/dev-kit.mjs catalog refresh",
    "catalog:check": "./bin/dev-kit.mjs catalog verify"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@stylistic/eslint-plugin": "5.10.0",
    "effect": "4.0.0-beta.102",
    "jsonc-parser": "3.3.1",
    "semver": "7.8.5",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0-next.10",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "25.9.1",
    "@types/semver": "7.8.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "oxfmt": ">=0.60.0 <0.61.0",
    "oxlint": ">=1.75.0 <2.0.0",
    "vite-plus": ">=0.2.6 <0.3.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
