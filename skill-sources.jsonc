{
  "$schema": "./schema/skill-sources.schema.json",
  "sources": [
    {
      "id": "emilkowalski-skills",
      "repository": "https://github.com/emilkowalski/skills.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": [
        "animation-vocabulary",
        "apple-design",
        "emil-design-eng",
        "find-animation-opportunities",
        "improve-animations",
        "pick-ui-library",
        "prototype",
        "review-animations"
      ],
      "licensePath": "LICENSE",
      "stripFrontmatter": [
        "disable-model-invocation"
      ]
    },
    {
      "id": "cloudflare-skills",
      "repository": "https://github.com/cloudflare/skills.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": [
        "agents-sdk",
        "cloudflare",
        "cloudflare-email-service",
        "cloudflare-one",
        "cloudflare-one-migrations",
        "durable-objects",
        "sandbox-sdk",
        "turnstile-spin",
        "web-perf",
        "workers-best-practices",
        "wrangler"
      ],
      "licensePath": "LICENSE"
    },
    {
      "id": "evanbacon-serve-sim",
      "repository": "https://github.com/EvanBacon/serve-sim.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": [
        "serve-sim"
      ],
      "licensePath": "LICENSE"
    }
  ],
  "packages": [
    {
      "id": "tanstack-ai",
      "package": "@tanstack/ai",
      "skillsPath": "skills",
      "include": ["ai-core"],
      "descriptions": {
        "ai-core": "Chat, tools, adapters, middleware, locks, structured output, media, AG-UI, and custom TanStack AI backends."
      }
    },
    {
      "id": "tanstack-ai-persistence",
      "package": "@tanstack/ai-persistence",
      "skillsPath": "skills",
      "include": ["ai-persistence"],
      "descriptions": {
        "ai-persistence": "Durable TanStack AI chat state, store contracts, and persistence-adapter recipes."
      }
    },
    {
      "id": "tanstack-ai-memory-skills",
      "package": "@tanstack/ai-memory",
      "skillsPath": "skills",
      "include": [
        "tanstack-ai-memory",
        "tanstack-ai-memory-hindsight",
        "tanstack-ai-memory-honcho",
        "tanstack-ai-memory-in-memory",
        "tanstack-ai-memory-mem0",
        "tanstack-ai-memory-redis"
      ],
      "descriptions": {
        "tanstack-ai-memory": "TanStack AI memory middleware and its recall/save adapter contract.",
        "tanstack-ai-memory-hindsight": "Hindsight memory adapter for TanStack AI.",
        "tanstack-ai-memory-honcho": "Honcho memory adapter for TanStack AI.",
        "tanstack-ai-memory-in-memory": "In-memory reference adapter for TanStack AI memory.",
        "tanstack-ai-memory-mem0": "Mem0 memory adapter for TanStack AI.",
        "tanstack-ai-memory-redis": "Redis memory adapter for TanStack AI."
      }
    },
    {
      "id": "tanstack-ai-mcp",
      "package": "@tanstack/ai-mcp",
      "skillsPath": "skills",
      "include": ["ai-mcp"],
      "descriptions": {
        "ai-mcp": "Connect MCP servers and use their tools, resources, prompts, and generated types in TanStack AI."
      }
    },
    {
      "id": "tanstack-ai-sandbox",
      "package": "@tanstack/ai-sandbox",
      "skillsPath": "skills",
      "include": ["ai-sandbox"],
      "descriptions": {
        "ai-sandbox": "Run TanStack AI harness adapters inside isolated, policy-controlled sandboxes."
      }
    },
    {
      "id": "tanstack-ai-code-mode",
      "package": "@tanstack/ai-code-mode",
      "skillsPath": "skills",
      "include": ["ai-code-mode"],
      "descriptions": {
        "ai-code-mode": "Execute LLM-generated TypeScript safely in isolated Code Mode environments."
      }
    }
  ]
}
