{
  "$schema": "./schema/skill-sources.schema.json",
  "sources": [
    {
      "id": "emilkowalski-skills",
      "repository": "https://github.com/emilkowalski/skills.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": [
        "animation-vocabulary",
        "apple-design",
        "emil-design-eng",
        "find-animation-opportunities",
        "improve-animations",
        "pick-ui-library",
        "prototype",
        "review-animations",
      ],
      "licensePath": "LICENSE",
      "stripFrontmatter": ["disable-model-invocation"],
    },
    {
      "id": "cloudflare-skills",
      "repository": "https://github.com/cloudflare/skills.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": [
        "agents-sdk",
        "cloudflare",
        "cloudflare-email-service",
        "cloudflare-one",
        "cloudflare-one-migrations",
        "durable-objects",
        "sandbox-sdk",
        "turnstile-spin",
        "web-perf",
        "workers-best-practices",
        "wrangler",
      ],
      "licensePath": "LICENSE",
    },
    {
      "id": "evanbacon-serve-sim",
      "repository": "https://github.com/EvanBacon/serve-sim.git",
      "ref": "main",
      "skillsPath": "skills",
      "include": ["serve-sim"],
      "licensePath": "LICENSE",
    },
    {
      "id": "mattpocock-skills",
      "repository": "https://github.com/mattpocock/skills.git",
      "ref": "main",
      "skillsPath": "skills/engineering",
      "include": ["tdd", "improve-codebase-architecture"],
      "licensePath": "LICENSE",
    },
    {
      "id": "expo-skills",
      "repository": "https://github.com/expo/skills.git",
      "ref": "main",
      "skillsPath": "plugins/expo/skills",
      "include": [
        "eas-app-stores",
        "eas-hosting",
        "eas-observe",
        "eas-simulator",
        "eas-update-insights",
        "eas-workflows",
        "expo-app-clip",
        "expo-brownfield",
        "expo-data-fetching",
        "expo-dev-client",
        "expo-dom",
        "expo-examples",
        "expo-module",
        "expo-native-ui",
        "expo-project-structure",
        "expo-router",
        "expo-skill-feedback",
        "expo-tailwind-setup",
        "expo-ui",
        "expo-upgrade",
        "expo-web-to-native",
      ],
      "licensePath": "LICENSE",
    },
  ],
}
